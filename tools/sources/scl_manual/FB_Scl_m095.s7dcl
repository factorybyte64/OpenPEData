{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_m095"
    VAR_INPUT
        vin : Variant;
        dba : DB_ANY;
    END_VAR
    VAR_IN_OUT
        by8 : Array[0..99] of Byte;
        arrA : Array[0..9] of Int;
        arrB : Array[0..9] of Int;
        barr : Array[0..15] of Bool;
        va : Array[*] of Int;
        pos : DInt;
    END_VAR
    VAR
        t1 : TON_TIME;
        mem : LReal;
    END_VAR
    VAR_TEMP
        i : Int;
        di : DInt;
        r : Real;
        lr : LReal;
        w : Word;
        dw : DWord;
        b : Bool;
        by : Byte;
        t : Time;
        ec : Int;
        o0 : Int;
        o1 : Int;
        v : Variant;
        udi : UDInt;
        b1 : Bool;
        b2 : Bool;
        b3 : Bool;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #w := ENDIS_PW(REQ := #b, F_PWD := #b, FULL_PWD := #b, R_PWD := #b, HMI_PWD := #b, F_PWD_ON => #b1, FULL_PWD_ON => #b2, R_PWD_ON => #b3, HMI_PWD_ON => #b1);
    END_NETWORK
END_FUNCTION_BLOCK
