{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex151"
    VAR_INPUT
        v_req : Bool;
        v_db_number : UInt;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_busy : Bool;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Delete_Db( REQ := #v_req, DB_NUMBER := #v_db_number, RET_VAL => #v_ret_val, BUSY => #v_busy )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
