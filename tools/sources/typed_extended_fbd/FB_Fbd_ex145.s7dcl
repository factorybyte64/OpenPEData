{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex145"
    VAR_INPUT
        v_req : Bool;
        v_records : UDInt;
        v_name : Array[0..99] of Byte;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_id : DWord;
        v_data : Variant;
    END_VAR
    VAR
        inst : DataLogNewFile;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.DataLogNewFile( REQ := #v_req, RECORDS := #v_records, NAME := #v_name, ID := #v_id, DONE => #v_done, BUSY => #v_busy, ERROR => #v_error, STATUS => #v_status, Data := #v_data )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
