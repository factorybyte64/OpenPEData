FUNCTION_BLOCK "FB_StlC_042"
TITLE = STL call PEEK_BOOL
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      a : Bool;
      i1 : Int;
      i2 : Int;
      di1 : DInt;
      r1 : Real;
      w1 : Word;
      dw1 : DWord;
      b1 : Byte;
      u1 : UInt;
      ud1 : UDInt;
   END_VAR
   VAR_OUTPUT
      q : Bool;
      io : Int;
      dio : DInt;
      ro : Real;
      wo : Word;
      dwo : DWord;
      bo : Byte;
      udo : UDInt;
   END_VAR
   VAR_IN_OUT
      v : Variant;
      arrs : Array[*] of Int;
      pos : DInt;
   END_VAR
   VAR
      src : Array[0..9] of Int;
      dst : Array[0..9] of Int;
      bits : Array[0..31] of Bool;
      bytes : Array[0..9] of Byte;
      err : ErrorStruct;
      rt : LReal;
      tim : IEC_TIMER;
      words : Array[0..3] of Word;
   END_VAR

BEGIN
NETWORK
TITLE = 042 PEEK_BOOL
      CALL PEEK_BOOL
      (  AREA := #b1 ,
         DBNUMBER := #di1 ,
         BYTEOFFSET := #di1 ,
         BITOFFSET := #i1 ,
         RET_VAL := #q
      );
END_FUNCTION_BLOCK
