FUNCTION_BLOCK "FB_StlC_077"
TITLE = STL call MCAT
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      a : Bool;
      b : Bool;
      c : Bool;
      ia : Int;
      ib : Int;
      ic : Int;
      da : DInt;
      db_v : DInt;
      ra_v : Real;
      rb : Real;
      wa : Word;
      wb : Word;
      dwa : DWord;
      ba : Byte;
      ta : Time;
      tb : Time;
      s1 : String;
      s2 : String;
   END_VAR
   VAR_OUTPUT 
      q : Bool;
      q2 : Bool;
      io : Int;
      io2 : Int;
      dout : DInt;
      rout : Real;
      wout : Word;
      dwout : DWord;
      bout : Byte;
      tout : Time;
      sout : String;
   END_VAR
   VAR_IN_OUT 
      arr : Array[0..9] of Int;
      barr : Array[0..7] of Bool;
      iinout : Int;
   END_VAR
   VAR 
      inst : MCAT;
      ton1 : TON_TIME;
      tof1 : TOF_TIME;
      tp1 : TP_TIME;
      tonr1 : TONR_TIME;
      ctu1 : CTU_INT;
      ctd1 : CTD_INT;
      ctud1 : CTUD_INT;
      rtrig1 : R_TRIG;
      ftrig1 : F_TRIG;
      edge1 : Bool;
      edge2 : Bool;
      stat1 : Bool;
      stat2 : Bool;
      stati : Int;
   END_VAR
   VAR_TEMP 
      t1 : Bool;
      t2 : Bool;
      ti : Int;
      td : DInt;
      tr : Real;
      tw : Word;
      tt : Time;
      var1 : Variant;
   END_VAR

BEGIN
NETWORK
TITLE = 077 MCAT
      CALL #inst
      (  O_CMD                       := #a , 
         C_CMD                       := #a , 
         S_CMD                       := #a , 
         O_FB                        := #a , 
         C_FB                        := #a , 
         OO                          := #q , 
         CO                          := #q , 
         OA                          := #q , 
         CA                          := #q , 
         Q                           := #q
      );
END_FUNCTION_BLOCK
