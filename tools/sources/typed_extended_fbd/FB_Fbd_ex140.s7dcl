{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex140"
    VAR_INPUT
        v_req : Bool;
        v_mode : UInt;
        v_name : Array[0..99] of Byte;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_id : DWord;
        v_data : Array[0..99] of Byte;
    END_VAR
    VAR
        inst : DataLogOpen;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.DataLogOpen( REQ := #v_req, MODE := #v_mode, NAME := #v_name, ID := #v_id, DATA := #v_data, DONE => #v_done, BUSY => #v_busy, ERROR => #v_error, STATUS => #v_status )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
