{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_sc004"
    VAR_INPUT
        v_en_r : Bool;
        v_id : CONN_PRG;
        v_r_id : CONN_R_ID;
    END_VAR
    VAR_OUTPUT
        v_ndr : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_rd_1 : Variant;
        v_rd_2 : Variant;
        v_rd_3 : Variant;
        v_rd_4 : Variant;
    END_VAR
    VAR
        inst : URCV;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.URCV(
                EN_R := #v_en_r,
                ID := #v_id,
                R_ID := #v_r_id,
                NDR => #v_ndr,
                ERROR => #v_error,
                STATUS => #v_status,
                RD_1 := #v_rd_1,
                RD_2 := #v_rd_2,
                RD_3 := #v_rd_3,
                RD_4 := #v_rd_4
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
