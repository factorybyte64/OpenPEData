{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex059"
    VAR_INPUT
        v_req : Bool;
        v_laddr : HW_IO;
        v_recnum : Byte;
        v_record : Variant;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_busy : Bool;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            WR_REC( REQ := #v_req, LADDR := #v_laddr, RECNUM := #v_recnum, RECORD := #v_record, RET_VAL => #v_ret_val, BUSY => #v_busy )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
