{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex044"
    VAR_INPUT
        v_part : PIP;
        v_ret_val : Int;
    END_VAR
    VAR_OUTPUT
        v_fladdr : Word;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Sync_Po( PART := #v_part, RET_VAL := #v_ret_val, FLADDR => #v_fladdr )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
