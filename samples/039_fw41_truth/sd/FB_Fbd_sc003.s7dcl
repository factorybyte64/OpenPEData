{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_sc003"
    VAR_INPUT
        v_req : Bool;
        v_id : CONN_PRG;
        v_r_id : CONN_R_ID;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_sd_1 : Variant;
        v_sd_2 : Variant;
        v_sd_3 : Variant;
        v_sd_4 : Variant;
    END_VAR
    VAR
        inst : USEND;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.USEND(
                REQ := #v_req,
                ID := #v_id,
                R_ID := #v_r_id,
                DONE => #v_done,
                ERROR => #v_error,
                STATUS => #v_status,
                SD_1 := #v_sd_1,
                SD_2 := #v_sd_2,
                SD_3 := #v_sd_3,
                SD_4 := #v_sd_4
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
