{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_sc006"
    VAR_INPUT
        v_en_r : Bool;
        v_id : CONN_PRG;
        v_r_id : CONN_R_ID;
    END_VAR
    VAR_OUTPUT
        v_ndr : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_rd_1 : Array[0..99] of Byte;
        v_len : Word;
    END_VAR
    VAR
        inst : Brcv;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.Brcv( EN_R := #v_en_r, ID := #v_id, R_ID := #v_r_id, RD_1 := #v_rd_1, LEN := #v_len, NDR => #v_ndr, ERROR => #v_error, STATUS => #v_status )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
