{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl058"
    VAR_INPUT
        v_area : Byte;
        v_dbnumber : DInt;
        v_byteoffset : DInt;
        v_bitoffset : Int;
        v_value : Bool;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        POKE_BOOL(AREA := #v_area, DBNUMBER := #v_dbnumber, BYTEOFFSET := #v_byteoffset, BITOFFSET := #v_bitoffset, VALUE := #v_value);
    END_NETWORK
END_FUNCTION_BLOCK
