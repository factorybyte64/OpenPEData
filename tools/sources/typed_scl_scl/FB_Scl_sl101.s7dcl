{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl101"
    VAR_INPUT
        v_wt : Int;
    END_VAR
    VAR_OUTPUT
        v_ret : Int;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #v_ret := WAIT(WT := #v_wt);
    END_NETWORK
END_FUNCTION_BLOCK
