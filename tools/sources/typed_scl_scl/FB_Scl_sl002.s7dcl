{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl002"
    VAR_INPUT
        v_clk : Bool;
    END_VAR
    VAR_OUTPUT
        v_q : Bool;
    END_VAR
    VAR
        inst : F_TRIG;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #inst(CLK := #v_clk, Q => #v_q);
    END_NETWORK
END_FUNCTION_BLOCK
