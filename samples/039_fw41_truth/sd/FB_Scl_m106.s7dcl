{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_m106"
    VAR_INPUT
        vin : Variant;
        dba : DB_ANY;
    END_VAR
    VAR_IN_OUT
        by8 : Array[0..99] of Byte;
        arrA : Array[0..9] of Int;
        arrB : Array[0..9] of Int;
        barr : Array[0..15] of Bool;
        va : Array[*] of Int;
        pos : DInt;
    END_VAR
    VAR
        t1 : TON_TIME;
        mem : LReal;
    END_VAR
    VAR_TEMP
        "i" : Int;
        "di" : DInt;
        r : Real;
        lr : LReal;
        "w" : Word;
        dw : DWord;
        "b" : Bool;
        "by" : Byte;
        "t" : Time;
        ec : Int;
        o0 : Int;
        o1 : Int;
        v : Variant;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        #i := MUX(K := #di, IN0 := 1, IN1 := 2);
    END_NETWORK
END_FUNCTION_BLOCK
