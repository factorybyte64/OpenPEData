FUNCTION_BLOCK "FB_Scl_sl120"
    VAR_INPUT
        v_in : DWord;
    END_VAR
    VAR_OUTPUT
        v_ret : DWord;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        #v_ret := BITSUM(IN := #v_in);
    END_NETWORK
END_FUNCTION_BLOCK
