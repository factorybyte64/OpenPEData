{
    S7_Optimized := "TRUE";
    S7_EditorMode := "SCL";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_SysMulti"
    VAR
        mTON_TIME : TON_TIME;
        mTOF_TIME : TOF_TIME;
        mTP_TIME : TP_TIME;
        mTONR_TIME : TONR_TIME;
        mTON_LTIME : TON_LTIME;
        mTOF_LTIME : TOF_LTIME;
        mTP_LTIME : TP_LTIME;
        mTONR_LTIME : TONR_LTIME;
        mCTU_INT : CTU_INT;
        mCTD_INT : CTD_INT;
        mCTUD_INT : CTUD_INT;
        mCTU_SINT : CTU_SINT;
        mCTU_DINT : CTU_DINT;
        mCTU_LINT : CTU_LINT;
        mCTU_UINT : CTU_UINT;
        mCTU_USINT : CTU_USINT;
        mCTU_UDINT : CTU_UDINT;
        mCTU_ULINT : CTU_ULINT;
        mCTD_DINT : CTD_DINT;
        mCTUD_DINT : CTUD_DINT;
        mCTUD_LINT : CTUD_LINT;
        mCTUD_UDINT : CTUD_UDINT;
        mR_TRIG : R_TRIG;
        mF_TRIG : F_TRIG;
        mTSEND_C : TSEND_C;
        mTRCV_C : TRCV_C;
        mTCON : TCON;
        mTDISCON : TDISCON;
        mTSEND : TSEND;
        mTRCV : TRCV;
        mTUSEND : TUSEND;
        mTURCV : TURCV;
        mTMAIL_C : TMAIL_C;
        mT_CONFIG : T_CONFIG;
        mGET : GET;
        mPUT : PUT;
        mUSEND : USEND;
        mURCV : URCV;
        mBSEND : BSEND;
        mBRCV : BRCV;
        mMB_CLIENT : MB_CLIENT;
        mMB_SERVER : MB_SERVER;
        mRDREC : RDREC;
        mWRREC : WRREC;
        mRALRM : RALRM;
        mGETIO : GETIO;
        mSETIO : SETIO;
        mGETIO_PART : GETIO_PART;
        mSETIO_PART : SETIO_PART;
        mProgram_Alarm : Program_Alarm;
        mDRUM : DRUM;
        mDCAT : DCAT;
        mMCAT : MCAT;
        mIMC : IMC;
        mSMC : SMC;
        mLEAD_LAG : LEAD_LAG;
        mPID_Compact : PID_Compact;
        mPID_3Step : PID_3Step;
        mPID_Temp : PID_Temp;
        mCONT_C : CONT_C;
        mCONT_S : CONT_S;
        mPULSEGEN : PULSEGEN;
        mTCONT_CP : TCONT_CP;
        mTCONT_S : TCONT_S;
        aTon : Array[0..1] of TON_TIME;
        aSend : Array[0..1] of TSEND_C;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #mTON_TIME(IN := TRUE, PT := T#1S);
    END_NETWORK
END_FUNCTION_BLOCK
