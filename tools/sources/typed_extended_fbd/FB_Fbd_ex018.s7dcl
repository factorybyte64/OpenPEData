{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex018"
    VAR_INPUT
        v_in : Time;
        v_format : Word;
        v_p : UInt;
    END_VAR
    VAR_OUTPUT
        v_out : Time;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            { S7_Templates := "[src_type := Time, dest_type := Time]" }
            Strg_Val( IN := #v_in, FORMAT := #v_format, P := #v_p, OUT => #v_out )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
