{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex122"
    VAR_INPUT
        v_operatemode : Byte;
        v_datamode : Byte;
        v_dispclassnr : Array[0..31] of UInt;
        v_lcid : UDInt;
    END_VAR
    VAR_OUTPUT
        v_dataready : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_init : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_data : AlarmData;
    END_VAR
    VAR
        inst : Get_Alarm;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.Get_Alarm( OperateMode := #v_operatemode, DataMode := #v_datamode, DispClassNr := #v_dispclassnr, Lcid := #v_lcid, Data := #v_data, DataReady => #v_dataready, Busy => #v_busy, Error => #v_error, Init => #v_init, Status => #v_status )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
