{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex006"
    VAR_INPUT
        v_in1 : Date;
        v_in2 : Time_Of_Day;
    END_VAR
    VAR_OUTPUT
        v_out : DTL;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            { S7_Templates := "[time_type := Time, date_type := DTL]" }
            T_Combine( IN1 := #v_in1, IN2 := #v_in2, OUT => #v_out )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
