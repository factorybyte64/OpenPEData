{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ex155"
    VAR_INPUT
        v_addr : Variant;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_laddr : HW_IO;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            IO2MOD(
                ADDR := #v_addr,
                RET_VAL => #v_ret_val,
                LADDR => #v_laddr
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
