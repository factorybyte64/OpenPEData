{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl045"
    VAR_INPUT
        v_in : Date;
        v_count : USInt;
    END_VAR
    VAR_OUTPUT
        v_out : Time_Of_Day;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        UFILL_BLK(IN := #v_in, COUNT := #v_count, OUT => #v_out);
    END_NETWORK
END_FUNCTION_BLOCK
