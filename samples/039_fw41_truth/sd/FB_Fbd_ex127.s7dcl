{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ex127"
    VAR_INPUT
        v_laddr : HW_IO;
        v_im_type : UInt;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_data : Array[0..99] of Byte;
    END_VAR
    VAR
        inst : Get_IM_Data;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.Get_IM_Data(
                LADDR := #v_laddr,
                IM_TYPE := #v_im_type,
                DONE => #v_done,
                BUSY => #v_busy,
                ERROR => #v_error,
                STATUS => #v_status,
                DATA := #v_data
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
