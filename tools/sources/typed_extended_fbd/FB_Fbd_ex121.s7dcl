{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex121"
    VAR_INPUT
        v_mode : UInt;
        v_textid : UInt;
        v_textlistid : UInt;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    VAR_IN_OUT
        v_assocvalues : AssocValues;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Gen_Usrmsg( Mode := #v_mode, TextID := #v_textid, TextListID := #v_textlistid, Ret_Val => #v_ret_val, AssocValues := #v_assocvalues )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
