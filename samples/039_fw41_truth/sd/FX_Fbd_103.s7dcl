{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FX_Fbd_103"
    VAR_INPUT
        "a" : Bool;
        "b" : Bool;
        "c" : Bool;
        ia : Int;
        "ib" : Int;
        ic : Int;
        da : DInt;
        "db" : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
    END_VAR
    VAR_IN_OUT
        p_in : Date;
        p_count : USInt;
        p_out : Date;
        s_in : Int;
        s_count : UDInt;
        s_out : Array[0..9] of Int;
        arr : Array[0..9] of Int;
        barr : Array[0..7] of Bool;
        iinout : Int;
    END_VAR
    VAR
        ton1 : TON_TIME;
        tof1 : TOF_TIME;
        tp1 : TP_TIME;
        tonr1 : TONR_TIME;
        ctu1 : CTU_INT;
        ctd1 : CTD_INT;
        ctud1 : CTUD_INT;
        rtrig1 : R_TRIG;
        ftrig1 : F_TRIG;
        edge1 : Bool;
        edge2 : Bool;
        stat1 : Bool;
        stat2 : Bool;
        stati : Int;
    END_VAR
    VAR_TEMP
        t1 : Bool;
        t2 : Bool;
        ti : Int;
        td : DInt;
        tr : Real;
        tw : Word;
        tt : Time;
        var1 : Variant;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_cK"
    }
    NETWORK
        RUNG
            FillBlockI(
                IN := #s_in,
                COUNT := #s_count,
                OUT => #s_out[0]
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
