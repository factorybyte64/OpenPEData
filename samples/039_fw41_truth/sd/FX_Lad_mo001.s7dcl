{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FX_Lad_mo001"
    VAR_INPUT
        "a" : Bool;
        "b" : Bool;
        "c" : Bool;
        ia : Int;
        "ib" : Int;
        ic : Int;
        da : DInt;
        "db" : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
    END_VAR
    VAR_IN_OUT
        x_usint : USInt;
        x_udint : UDInt;
        x_uint : UInt;
        x_word : Word;
        arr : Array[0..9] of Int;
        barr : Array[0..7] of Bool;
        iinout : Int;
    END_VAR
    VAR
        { S7_Setpoint := "False" }
        inst : MB_CLIENT;
        ton1 : TON_TIME;
        tof1 : TOF_TIME;
        tp1 : TP_TIME;
        tonr1 : TONR_TIME;
        ctu1 : CTU_INT;
        ctd1 : CTD_INT;
        ctud1 : CTUD_INT;
        rtrig1 : R_TRIG;
        ftrig1 : F_TRIG;
        edge1 : Bool;
        edge2 : Bool;
        stat1 : Bool;
        stat2 : Bool;
        stati : Int;
    END_VAR
    VAR_TEMP
        t1 : Bool;
        t2 : Bool;
        ti : Int;
        td : DInt;
        tr : Real;
        tw : Word;
        tt : Time;
        var1 : Variant;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_46U"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.MB_CLIENT(
                REQ := #"a",
                DISCONNECT := #"a",
                MB_MODE := #x_usint,
                MB_DATA_ADDR := #x_usint,
                MB_DATA_LEN := #x_usint,
                RD_MB_DATA_ADDR := #x_usint,
                RD_MB_DATA_LEN := #x_usint,
                WR_MB_DATA_ADDR := #x_usint,
                WR_MB_DATA_LEN := #x_usint,
                DONE => #"a",
                BUSY => #"a",
                ERROR => #"a",
                STATUS => #x_usint,
                MB_DATA_PTR := #x_usint,
                CONNECT := #x_usint,
                RD_MB_DATA_PTR := #x_usint,
                WR_MB_DATA_PTR := #x_usint
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
