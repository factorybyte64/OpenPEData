{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex101"
    VAR_INPUT
        v_ob_nr : OB_ATT;
        v_event : EVENT_ATT;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Detach( OB_NR := #v_ob_nr, EVENT := #v_event, RET_VAL => #v_ret_val )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
