{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_TrcvC"
    VAR_INPUT
        en_r : Bool;
        cont : Bool;
        len : UInt;
        id : CONN_OUC;
        adhoc : Bool;
    END_VAR
    VAR_OUTPUT
        done : Bool;
        busy : Bool;
        err : Bool;
        status : Word;
        rcvdlen : UInt;
    END_VAR
    VAR_IN_OUT
        connect : TCON_IP_v4;
        data : Array[0..99] of Byte;
        comrst : Bool;
        addr : Variant;
    END_VAR
    VAR
        inst : TRCV_C;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.TRCV_C( EN_R := #en_r, CONT := #cont, LEN := #len, CONNECT := #connect, DATA := #data, COM_RST := #comrst, DONE => #done, BUSY => #busy, ERROR => #err, STATUS => #status, RCVD_LEN => #rcvdlen, ADHOC := #adhoc, ADDR := #addr )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
