{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl068"
    VAR_INPUT
        v_arr : Array[0..9] of Byte;
        v_dim : UDInt;
    END_VAR
    VAR_OUTPUT
        v_ret : Array[0..9] of Byte;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #v_ret := UPPER_BOUND(ARR := #v_arr, DIM := #v_dim);
    END_NETWORK
END_FUNCTION_BLOCK
