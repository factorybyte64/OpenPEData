{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_059"
    VAR_INPUT
        a : Bool;
        b : Bool;
        c : Bool;
        ia : Int;
        ib : Int;
        ic : Int;
        da : DInt;
        db : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
        tmr : Timer;
        cntr : Counter;
        s5a : S5Time;
        uia : UInt;
        udia : UDInt;
        usia : USInt;
        lra : LReal;
        dba : DB_ANY;
        bytes : Array[0..7] of Byte;
        v1 : Variant;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
        wout2 : Word;
        lout : LReal;
        eout : ErrorStruct;
    END_VAR
    VAR_IN_OUT
