{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ou016"
    VAR_INPUT
        v_en_r : Bool;
        v_id : CONN_OUC;
        v_len : UDInt;
        v_adhoc : Bool;
    END_VAR
    VAR_OUTPUT
        v_ndr : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
        v_rcvd_len : UDInt;
    END_VAR
    VAR_IN_OUT
        v_data : Array[0..99] of Byte;
    END_VAR
    VAR
        inst : TRCV;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.TRCV(
                EN_R := #v_en_r,
                ID := #v_id,
                LEN := #v_len,
                ADHOC := #v_adhoc,
                NDR => #v_ndr,
                BUSY => #v_busy,
                ERROR => #v_error,
                STATUS => #v_status,
                RCVD_LEN => #v_rcvd_len,
                DATA := #v_data
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
