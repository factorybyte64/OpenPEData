{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ou004"
    VAR_INPUT
        v_en_r : Bool;
        v_cont : Bool;
        v_len : UDInt;
        v_adhoc : Bool;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
        v_rcvd_len : UDInt;
    END_VAR
    VAR_IN_OUT
        v_connect : Array[0..99] of Byte;
        v_data : Array[0..99] of Byte;
        v_addr : Array[0..99] of Byte;
        v_com_rst : Bool;
    END_VAR
    VAR
        inst : TrcvC;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.TrcvC( EN_R := #v_en_r, CONT := #v_cont, LEN := #v_len, ADHOC := #v_adhoc, CONNECT := #v_connect, DATA := #v_data, ADDR := #v_addr, COM_RST := #v_com_rst, DONE => #v_done, BUSY => #v_busy, ERROR => #v_error, STATUS => #v_status, RCVD_LEN => #v_rcvd_len )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
