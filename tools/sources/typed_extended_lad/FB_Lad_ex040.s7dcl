{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex040"
    VAR_INPUT
        v_size : DInt;
    END_VAR
    VAR_OUTPUT
        v_ret_val : WString;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            GetBlockName( SIZE := #v_size, RET_VAL => #v_ret_val )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
