{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ex153"
    VAR_INPUT
        v_laddr : HW_ANY;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    VAR_IN_OUT
        v_geoaddr : GEOADDR;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            LOG2GEO(
                LADDR := #v_laddr,
                Ret_Val => #v_ret_val,
                GEOADDR := #v_geoaddr
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
