{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FX_Lad_ex086"
    VAR_INPUT
        "a" : Bool;
        "b" : Bool;
        "c" : Bool;
        ia : Int;
        "ib" : Int;
        ic : Int;
        da : DInt;
        "db" : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
    END_VAR
    VAR_IN_OUT
        p_reset : Bool;
        p_id : HW_SUBMODULE;
        p_valid : Bool;
        p_cmd_para : Variant;
        p_data_errorrsp : Variant;
        p_index : Int;
        p_cmd : Int;
        p_new : Bool;
        p_error : Bool;
        p_status : DWord;
        arr : Array[0..9] of Int;
        barr : Array[0..7] of Bool;
        iinout : Int;
    END_VAR
    VAR
        { S7_Setpoint := "False" }
        inst : PE_I_DEV;
        ton1 : TON_TIME;
        tof1 : TOF_TIME;
        tp1 : TP_TIME;
        tonr1 : TONR_TIME;
        ctu1 : CTU_INT;
        ctd1 : CTD_INT;
        ctud1 : CTUD_INT;
        rtrig1 : R_TRIG;
        ftrig1 : F_TRIG;
        edge1 : Bool;
        edge2 : Bool;
        stat1 : Bool;
        stat2 : Bool;
        stati : Int;
    END_VAR
    VAR_TEMP
        t1 : Bool;
        t2 : Bool;
        ti : Int;
        td : DInt;
        tr : Real;
        tw : Word;
        tt : Time;
        var1 : Variant;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_4eu"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.PE_I_DEV(
                RESET := #p_reset,
                ID := #p_id,
                VALID := #p_valid,
                INDEX => #p_index,
                CMD => #p_cmd,
                CMD_MODIFIER => #io,
                NEW => #p_new,
                ERROR => #p_error,
                STATUS => #p_status,
                CMD_PARA := #p_cmd_para,
                DATA_ERRORRSP := #p_data_errorrsp
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
