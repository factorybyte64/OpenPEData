{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex129"
    VAR_INPUT
        v_req : Bool;
        v_laddr : HW_DEVICE;
        v_detail : HW_SUBMODULE;
        v_mode : UInt;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_data : Array[0..99] of Byte;
    END_VAR
    VAR
        inst : GetStationInfo;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.GetStationInfo( REQ := #v_req, LADDR := #v_laddr, DETAIL := #v_detail, MODE := #v_mode, DATA := #v_data, DONE => #v_done, BUSY => #v_busy, ERROR => #v_error, STATUS => #v_status )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
