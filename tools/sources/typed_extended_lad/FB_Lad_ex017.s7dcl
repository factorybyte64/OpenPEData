{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex017"
    VAR_INPUT
        v_in : Time;
    END_VAR
    VAR_OUTPUT
        v_out : Time;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            { S7_Templates := "[src_type := Time, dest_type := Time]" }
            S_Conv( IN := #v_in, OUT => #v_out )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
