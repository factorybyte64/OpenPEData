{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_pt004"
    VAR_INPUT
        v_req : Bool;
        v_port : PORT;
        v_buffer : Variant;
        v_length : UInt;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_universal : Variant;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Send_P2P( REQ := #v_req, PORT := #v_port, BUFFER := #v_buffer, LENGTH := #v_length, PTRCL := TRUE, DONE => #v_done, ERROR => #v_error, STATUS => #v_status, UNIVERSAL := #v_universal )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
