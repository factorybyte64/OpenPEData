}
FUNCTION_BLOCK "FB_Lad_ex034"
    VAR_INPUT
        v_in1 : Int;
        v_in2 : Int;
        v_l : Byte;
        v_p : Byte;
    END_VAR
    VAR_OUTPUT
        v_out : Int;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
