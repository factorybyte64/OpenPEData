{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex041"
    VAR_INPUT
        v_part : PIP;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_fladdr : Word;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Updat_Pi( PART := #v_part, RET_VAL => #v_ret_val, FLADDR => #v_fladdr )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
