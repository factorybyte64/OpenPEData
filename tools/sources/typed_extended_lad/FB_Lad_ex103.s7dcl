{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex103"
    VAR_INPUT
        v_ob_nr : Int;
        v_ret_val : Int;
    END_VAR
    VAR_OUTPUT
        v_cycle : UDInt;
        v_phase : UDInt;
        v_status : Word;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Qry_Cint( OB_NR := #v_ob_nr, CYCLE => #v_cycle, PHASE => #v_phase, STATUS => #v_status, RET_VAL := #v_ret_val )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
