<Window x:Class="OpenPEData.Viewer.Updates.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updates – OpenPEData Viewer" Height="560" Width="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PaneBg}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">
        <!-- installed version and settings -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="InstalledText" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstallHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
            <CheckBox x:Name="AutoCheckBox" Margin="0,10,0,0" Checked="OnSettingChanged" Unchecked="OnSettingChanged"
                      Content="Check for updates automatically (at startup and every 12 hours)"/>
            <CheckBox x:Name="PrereleaseBox" Margin="0,6,0,0" Checked="OnPrereleaseChanged" Unchecked="OnPrereleaseChanged"
                      Content="Include pre-releases"/>
            <DockPanel Margin="0,10,0,6">
                <Button x:Name="CheckButton" DockPanel.Dock="Left" Padding="10,4" Click="OnCheck">Check now</Button>
                <TextBlock x:Name="CheckStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </StackPanel>

        <!-- actions -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Padding="14,4" Margin="6,0,0,0" IsCancel="True" Click="OnClose">Close</Button>
            <Button x:Name="InstallButton" DockPanel.Dock="Right" Padding="14,4" Margin="6,0,0,0" IsEnabled="False" Click="OnInstall">Install</Button>
            <Button x:Name="SkipButton" DockPanel.Dock="Right" Padding="14,4" Margin="6,0,0,0" Visibility="Collapsed" Click="OnSkip"
                    ToolTip="Do not offer this version automatically again; a newer version is offered again">Skip this version</Button>
            <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center"/>
            <TextBlock/>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
            </Grid.RowDefinitions>
            <ListView x:Name="ReleaseList" Grid.Row="0" SelectionMode="Single" SelectionChanged="OnReleaseSelected">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Version" Width="110" DisplayMemberBinding="{Binding Version}"/>
                        <GridViewColumn Header="Published" Width="110" DisplayMemberBinding="{Binding Published}"/>
                        <GridViewColumn Header="Kind" Width="100" DisplayMemberBinding="{Binding Kind}"/>
                        <GridViewColumn Header="Status" Width="330" DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <DockPanel Grid.Row="1" Margin="0,8,0,4">
                <TextBlock DockPanel.Dock="Right">
                    <Hyperlink x:Name="ReleaseLink" Click="OnOpenReleasePage">Open on GitHub</Hyperlink>
                </TextBlock>
                <TextBlock Text="Release notes" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBox x:Name="NotesBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Padding="6,4"/>
        </Grid>
    </DockPanel>
</Window>
