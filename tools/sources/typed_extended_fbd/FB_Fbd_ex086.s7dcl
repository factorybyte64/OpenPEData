{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex086"
    VAR_INPUT
        v_reset : Bool;
        v_id : HW_SUBMODULE;
        v_valid : Bool;
    END_VAR
    VAR_OUTPUT
        v_cmd_para : Int;
        v_index : Int;
        v_cmd : Int;
        v_new : Bool;
        v_error : Bool;
        v_status : DWord;
    END_VAR
    VAR_IN_OUT
        v_data_errorrsp : Int;
        v_cmd_modifier : Variant;
    END_VAR
    VAR
        inst : Pe_I_Dev;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.Pe_I_Dev( RESET := #v_reset, ID := #v_id, VALID := #v_valid, CMD_PARA => #v_cmd_para, DATA_ERRORRSP := #v_data_errorrsp, INDEX => #v_index, CMD => #v_cmd, NEW => #v_new, ERROR => #v_error, STATUS => #v_status, CMD_MODIFIER := #v_cmd_modifier )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
