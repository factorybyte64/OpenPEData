{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex125"
    VAR_INPUT
        v_mode : UInt;
        v_ob : OB_ANY;
        v_ret_val : Int;
    END_VAR
    VAR_IN_OUT
        v_info : Variant;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Rt_Info( MODE := #v_mode, OB := #v_ob, RET_VAL := #v_ret_val, INFO := #v_info )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
