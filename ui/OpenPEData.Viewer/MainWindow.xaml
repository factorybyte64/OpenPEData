<Window x:Class="OpenPEData.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenPEData.Viewer"
        Title="OpenPEData Viewer" Height="820" Width="1360" MinWidth="720" MinHeight="420"
        Background="{StaticResource PaneBg}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="ToolGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <!-- the count or type of a node as a quiet note after the name -->
                <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center" Margin="7,0,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolButton}" Click="OnOpenFile" ToolTip="Open a TIA project, project archive, global library or library archive (Ctrl+O)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8E5;"/><TextBlock Text="Open TIA file"/></StackPanel>
                    </Button>
                    <Button x:Name="ReloadButton" Style="{StaticResource ToolButton}" Click="OnReload" IsEnabled="False" ToolTip="Reload (F5)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72C;"/><TextBlock Text="Reload"/></StackPanel>
                    </Button>
                    <Button x:Name="UpdateNotice" Style="{StaticResource ToolButton}" Click="OnUpdates" Visibility="Collapsed"
                            Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
                    <Border Width="1" Background="{StaticResource Line}" Margin="4,2,10,2"/>
                    <TextBlock Text="Language" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{StaticResource Muted}"/>
                    <ComboBox x:Name="LangBox" MinWidth="90" VerticalContentAlignment="Center" SelectionChanged="OnLanguageChanged"
                              ToolTip="Runtime language of the screen texts (languages of the HMI devices; without its own text, the default text)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Click="OnUpdates" ToolTip="Updates: check, install any version (update or downgrade)" Content="&#xE895;"/>
                    <Button Style="{StaticResource IconButton}" Click="OnSettings" ToolTip="Settings" Content="&#xE713;"/>
                    <Button Style="{StaticResource IconButton}" Click="OnAbout" ToolTip="About OpenPEData Viewer" Content="&#xE946;"/>
                </StackPanel>
                <Grid DockPanel.Dock="Right" Width="280" HorizontalAlignment="Right">
                    <TextBox x:Name="FilterBox" Padding="6,4" TextChanged="OnFilterChanged" VerticalContentAlignment="Center"
                             ToolTip="Search in project: shows the objects whose name contains the text (Ctrl+F)"/>
                    <TextBlock Text="Search in project…" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="140" Height="10" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           Text="Open a TIA file, or drag a project, archive, library or project folder here."/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- project tree -->
            <DockPanel Grid.Column="0" Background="White">
                <TextBlock DockPanel.Dock="Top" Text="Project navigation" FontWeight="SemiBold" Padding="10,8,10,6"
                           Background="{StaticResource HeaderBg}"/>
                <TreeView x:Name="Tree" BorderThickness="0" Padding="2,4" SelectedItemChanged="OnSelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Style.Triggers>
                                <!-- a gap between the project and the OpenPEData views -->
                                <DataTrigger Binding="{Binding Kind}" Value="Overview">
                                    <Setter Property="Margin" Value="0,10,0,0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- detail pane -->
            <DockPanel Grid.Column="2" Background="White">
                <Border DockPanel.Dock="Top" Padding="14,10,14,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock x:Name="DetailPath" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <TabControl x:Name="DetailTabs" BorderThickness="0,1,0,0" Padding="0" SelectionChanged="OnTabChanged"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
