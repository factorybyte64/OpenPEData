{
    S7_Optimized := "TRUE";
    S7_EditorMode := "SCL";
    S7_Version := "0.1"
}
FUNCTION "FC_Ton" : Void
    VAR_INPUT
        start : Bool;
    END_VAR
    VAR_OUTPUT
        q : Bool;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        "DBTon".TON(IN := #start, PT := T#2S);
        #q := "DBTon".Q;
    END_NETWORK
END_FUNCTION
