<Window x:Class="OpenPEData.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenPEData.Viewer"
        Title="OpenPEData Viewer" Height="820" Width="1360" MinWidth="720" MinHeight="420"
        Background="{StaticResource PaneBg}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolButton}" Click="OnOpenFile" ToolTip="Open project file (.ap21 or .zap21), Ctrl+O">Open file…</Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnOpenFolder" ToolTip="Open project folder">Open folder…</Button>
                    <Button x:Name="ReloadButton" Style="{StaticResource ToolButton}" Click="OnReload" IsEnabled="False" ToolTip="Reload (F5)">Reload</Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnAbout" ToolTip="Version and parser">Info</Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnUpdates" ToolTip="Check for updates, install any version (update or downgrade)">Updates…</Button>
                    <Button x:Name="UpdateNotice" Style="{StaticResource ToolButton}" Click="OnUpdates" Visibility="Collapsed"
                            Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
                    <TextBlock Text="Language" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="{StaticResource Muted}"/>
                    <ComboBox x:Name="LangBox" MinWidth="90" VerticalContentAlignment="Center" SelectionChanged="OnLanguageChanged"
                              ToolTip="Runtime language of the screen texts (languages of the HMI devices; without its own text, the default text)"/>
                    <CheckBox x:Name="RuntimeVisibilityBox" Content="Like runtime (respect Visible)" VerticalAlignment="Center" Margin="12,0,0,0"
                              Checked="OnRuntimeVisibilityChanged" Unchecked="OnRuntimeVisibilityChanged"
                              ToolTip="Off: like the TIA screen editor, objects with Visible=false are drawn. On: like the runtime, they are missing."/>
                </StackPanel>
                <Grid DockPanel.Dock="Right" Width="280" HorizontalAlignment="Right">
                    <TextBox x:Name="FilterBox" Padding="6,4" TextChanged="OnFilterChanged" VerticalContentAlignment="Center"
                             ToolTip="Filter tree by name (Ctrl+F)"/>
                    <TextBlock Text="Search in tree…" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="140" Height="10" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           Text="Open a project, or drag an .ap21/.zap21 file or a project folder here."/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- project tree -->
            <DockPanel Grid.Column="0" Background="White">
                <TextBlock DockPanel.Dock="Top" Text="Project tree" FontWeight="SemiBold" Padding="10,8,10,6"
                           Background="{StaticResource HeaderBg}"/>
                <TreeView x:Name="Tree" BorderThickness="0" Padding="2,4" SelectedItemChanged="OnSelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- detail pane -->
            <DockPanel Grid.Column="2" Background="White">
                <Border DockPanel.Dock="Top" Padding="14,10,14,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock x:Name="DetailPath" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <TabControl x:Name="DetailTabs" BorderThickness="0,1,0,0" Padding="0" SelectionChanged="OnTabChanged"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
