{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ex061"
    VAR_INPUT
        v_laddr : HW_IO;
        v_record : Variant;
        v_ret_val : Int;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            DPWR_DAT(
                LADDR := #v_laddr,
                RECORD := #v_record,
                RET_VAL => #v_ret_val
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
