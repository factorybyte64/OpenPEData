{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex015"
    VAR_INPUT
        v_in : String;
    END_VAR
    VAR_OUTPUT
        v_out : String;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            S_Move( IN := #v_in, OUT => #v_out )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
