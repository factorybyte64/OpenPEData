{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ex126"
    VAR_INPUT
        v_laddr : HW_IO;
        v_led : UInt;
        v_ret_val : Int;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            LED(
                LADDR := #v_laddr,
                LED := #v_led,
                Ret_Val => #v_ret_val
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
