{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ex026"
    VAR_INPUT
        v_n : UInt;
        v_ret_val : Word;
    END_VAR
    VAR_IN_OUT
        v_in : Variant;
        v_out : Variant;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            HexToAscii(
                in := #v_in,
                n := #v_n,
                ret_val => #v_ret_val,
                out => #v_out
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
