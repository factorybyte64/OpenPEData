{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex152"
    VAR_INPUT
        v_geoaddr : GEOADDR;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_laddr : UInt;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Geo2log( GEOADDR := #v_geoaddr, RET_VAL => #v_ret_val, LADDR => #v_laddr )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
