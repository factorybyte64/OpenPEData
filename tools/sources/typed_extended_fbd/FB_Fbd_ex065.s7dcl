    VAR_INPUT
        v_req : Bool;
        v_laddr : HW_DPSLAVE;
    END_VAR
    VAR_OUTPUT
        v_ret_val : DInt;
        v_busy : Bool;
    END_VAR
    VAR_IN_OUT
        v_record : Variant;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Dpnrm_Dg( REQ := #v_req, LADDR := #v_laddr, RET_VAL => #v_ret_val, RECORD := #v_record, BUSY => #v_busy )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
