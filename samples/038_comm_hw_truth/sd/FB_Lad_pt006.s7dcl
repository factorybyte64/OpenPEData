{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_pt006"
    VAR_INPUT
        v_req : Bool;
        v_port : PORT;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR
        inst : Receive_Reset;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.Receive_Reset(
                REQ := #v_req,
                PORT := #v_port,
                DONE => #v_done,
                ERROR => #v_error,
                STATUS => #v_status
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
