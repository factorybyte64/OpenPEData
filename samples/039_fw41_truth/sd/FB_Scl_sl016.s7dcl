{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl016"
    VAR_INPUT
        v_cu : Bool;
        v_cd : Bool;
        v_r : Bool;
        v_ld : Bool;
        v_pv : Int;
    END_VAR
    VAR_OUTPUT
        v_qu : Bool;
        v_qd : Bool;
        v_cv : Char;
    END_VAR
    VAR
        inst : CTUD_INT;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        #inst(CU := #v_cu, CD := #v_cd, R := #v_r, LD := #v_ld, PV := #v_pv, QU => #v_qu, QD => #v_qd, CV => #v_cv);
    END_NETWORK
END_FUNCTION_BLOCK
