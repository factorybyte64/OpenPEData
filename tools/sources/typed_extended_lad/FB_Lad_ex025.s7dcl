{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex025"
    VAR_INPUT
        v_n : Int;
        v_ret_val : Word;
    END_VAR
    VAR_IN_OUT
        v_in : Variant;
        v_out : Variant;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Ath( IN := #v_in, N := #v_n, RET_VAL := #v_ret_val, OUT := #v_out )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
