{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Motor"
    VAR_INPUT
        start : Bool;
        setSpeed : Real;
    END_VAR
    VAR_OUTPUT
        running : Bool;
    END_VAR
    VAR
        tOn : TON_TIME;
        hours : DInt := 100;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        #tOn(IN := #start, PT := T#2S);
        #running := #tOn.Q;
    END_NETWORK
END_FUNCTION_BLOCK
