{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FX_Fbd_ex091"
    VAR_INPUT
        "a" : Bool;
        "b" : Bool;
        "c" : Bool;
        ia : Int;
        "ib" : Int;
        ic : Int;
        da : DInt;
        "db" : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
    END_VAR
    VAR_IN_OUT
        p_pe_i_dev_new : Bool;
        p_cmd : Int;
        p_cmd_modifier : Int;
        p_pe_mode_id : Byte;
        p_pe_mode_attributes : Byte;
        p_time_min_pause : DWord;
        p_time_to_pause : DWord;
        p_time_to_operate : DWord;
        p_time_max_lenght_of_stay : DWord;
        p_activate : Bool;
        p_valid : Bool;
        p_error : Bool;
        p_status : Word;
        x_dword : DWord;
        arr : Array[0..9] of Int;
        barr : Array[0..7] of Bool;
        iinout : Int;
    END_VAR
    VAR
        ton1 : TON_TIME;
        tof1 : TOF_TIME;
        tp1 : TP_TIME;
        tonr1 : TONR_TIME;
        ctu1 : CTU_INT;
        ctd1 : CTD_INT;
        ctud1 : CTUD_INT;
        rtrig1 : R_TRIG;
        ftrig1 : F_TRIG;
        edge1 : Bool;
        edge2 : Bool;
        stat1 : Bool;
        stat2 : Bool;
        stati : Int;
    END_VAR
    VAR_TEMP
        t1 : Bool;
        t2 : Bool;
        ti : Int;
        td : DInt;
        tr : Real;
        tw : Word;
        tt : Time;
        var1 : Variant;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_3eH"
    }
    NETWORK
        RUNG
            PE_Get_Mode_RSP(
                PE_I_DEV_NEW := #p_pe_i_dev_new,
                CMD := #p_cmd,
                CMD_MODIFIER := #p_cmd_modifier,
                PE_Mode_ID := #p_pe_mode_id,
                PE_Mode_Attributes := #p_pe_mode_attributes,
                Time_min_Pause := #p_time_min_pause,
                Time_to_Pause := #p_time_to_pause,
                Time_to_Operate := #p_time_to_operate,
                Time_min_Length_of_stay := #x_dword,
                Time_max_length_of_stay := #x_dword,
                Mode_Power_Consumption := #wa,
                Energy_Consum_to_Pause := #wa,
                Energy_Consum_to_operate := #wa,
                ERROR => #p_error,
                STATUS => #p_status,
                Activate := #p_activate,
                VALID := #p_valid,
                DATA_ERRORRSP := #iinout
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
