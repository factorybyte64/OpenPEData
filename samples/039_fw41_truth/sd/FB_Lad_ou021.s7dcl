{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ou021"
    VAR_INPUT
        v_req : Bool;
        v_interface : HW_INTERFACE;
        v_conf_data : Array[0..99] of Byte;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : DWord;
        v_err_loc : DWord;
    END_VAR
    VAR
        inst : T_CONFIG;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.T_CONFIG(
                Req := #v_req,
                Interface := #v_interface,
                Conf_Data := #v_conf_data,
                Done => #v_done,
                Busy => #v_busy,
                Error => #v_error,
                Status => #v_status,
                Err_Loc => #v_err_loc
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
