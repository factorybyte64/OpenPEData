{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex004"
    VAR_INPUT
        v_in1 : Time;
        v_in2 : Time;
    END_VAR
    VAR_OUTPUT
        v_out : Time;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            { S7_Templates := "[date_type := DTL, time_type := Time]" }
            T_Sub( IN1 := #v_in1, IN2 := #v_in2, OUT => #v_out )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
