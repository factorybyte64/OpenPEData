    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
        { S7_Templates := "SrcType := Int" }
        LT_Contact( in1 := #ia, in2 := #ib )
        Coil( #q )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
