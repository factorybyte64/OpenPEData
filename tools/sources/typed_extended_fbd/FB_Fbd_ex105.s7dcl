{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex105"
    VAR_INPUT
        v_ob_nr : OB_TOD;
        v_sdt : DTL;
        v_local : Bool;
        v_period : Word;
        v_activate : Bool;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Set_Tintl( OB_NR := #v_ob_nr, SDT := #v_sdt, LOCAL := #v_local, PERIOD := #v_period, ACTIVATE := #v_activate, RET_VAL => #v_ret_val )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
