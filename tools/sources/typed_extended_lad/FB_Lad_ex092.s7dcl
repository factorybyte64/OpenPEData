{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex092"
    VAR_INPUT
        v_pe_i_dev_new : Bool;
        v_cmd : Int;
    END_VAR
    VAR_OUTPUT
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_activate : Bool;
        v_valid : Bool;
        v_pe_mode_id_source : Variant;
        v_pe_mode_id_destination : Variant;
        v_time_to_operate : Variant;
        v_remaining_time_to_dest : Variant;
        v_mode_power_consumption : Variant;
        v_energy_cons_to_dest : Variant;
        v_energy_cons_to_operate : Variant;
        v_data_errorrsp : Variant;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Pe_Pem_Status_Rsp( PE_I_DEV_NEW := #v_pe_i_dev_new, CMD := #v_cmd, ACTIVATE := #v_activate, VALID := #v_valid, ERROR => #v_error, STATUS => #v_status, PE_MODE_ID_Source := #v_pe_mode_id_source, PE_MODE_ID_Destination := #v_pe_mode_id_destination, Time_to_Operate := #v_time_to_operate, Remaining_time_to_dest := #v_remaining_time_to_dest, Mode_Power_Consumption := #v_mode_power_consumption, Energy_Cons_to_dest := #v_energy_cons_to_dest, Energy_Cons_to_operate := #v_energy_cons_to_operate, DATA_ERRORRSP := #v_data_errorrsp )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
