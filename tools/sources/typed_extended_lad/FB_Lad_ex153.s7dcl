{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex153"
    VAR_INPUT
        v_laddr : HW_ANY;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    VAR_IN_OUT
        v_geoaddr : GEOADDR;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Log2geo( LADDR := #v_laddr, RET_VAL => #v_ret_val, GEOADDR := #v_geoaddr )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
