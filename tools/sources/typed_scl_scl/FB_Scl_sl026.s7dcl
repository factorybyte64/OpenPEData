{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl026"
    VAR_INPUT
        v_in1 : Time;
        v_in2 : Time;
    END_VAR
    VAR_OUTPUT
        v_ret : Time;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #v_ret := MAX(IN1 := #v_in1, IN2 := #v_in2);
    END_NETWORK
END_FUNCTION_BLOCK
