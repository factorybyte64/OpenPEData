{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Typed"
    VAR_INPUT
        in1 : Int;
    END_VAR
    VAR_OUTPUT
        out1 : Int;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #out1 := #in1 + 1;
    END_NETWORK
END_FUNCTION_BLOCK
