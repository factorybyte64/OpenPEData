{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ou014"
    VAR_INPUT
        v_req : Bool;
        v_id : CONN_OUC;
        v_len : UDInt;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_data : Array[0..99] of Byte;
    END_VAR
    VAR
        inst : TSEND;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.TSEND(
                REQ := #v_req,
                ID := #v_id,
                LEN := #v_len,
                DONE => #v_done,
                BUSY => #v_busy,
                ERROR => #v_error,
                STATUS => #v_status,
                DATA := #v_data
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
