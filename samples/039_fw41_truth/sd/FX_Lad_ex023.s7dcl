{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FX_Lad_ex023"
    VAR_INPUT
        "a" : Bool;
        "b" : Bool;
        "c" : Bool;
        ia : Int;
        "ib" : Int;
        ic : Int;
        da : DInt;
        "db" : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
    END_VAR
    VAR_IN_OUT
        p_mode : DWord;
        p_recseparator : Variant;
        p_endseparator : Variant;
        p_srcstruct : Variant;
        p_count : UDInt;
        p_destarray : Variant;
        p_position : UDInt;
        p_ret_val : Int;
        s_mode : DWord;
        s_recseparator : String;
        s_endseparator : String;
        s_srcstruct : Array[0..3] of String;
        s_count : UDInt;
        s_position : UDInt;
        s_ret_val : Int;
        s_dstarray : Array[0..99] of Char;
        arr : Array[0..9] of Int;
        barr : Array[0..7] of Bool;
        iinout : Int;
    END_VAR
    VAR
        ton1 : TON_TIME;
        tof1 : TOF_TIME;
        tp1 : TP_TIME;
        tonr1 : TONR_TIME;
        ctu1 : CTU_INT;
        ctd1 : CTD_INT;
        ctud1 : CTUD_INT;
        rtrig1 : R_TRIG;
        ftrig1 : F_TRIG;
        edge1 : Bool;
        edge2 : Bool;
        stat1 : Bool;
        stat2 : Bool;
        stati : Int;
    END_VAR
    VAR_TEMP
        t1 : Bool;
        t2 : Bool;
        ti : Int;
        td : DInt;
        tr : Real;
        tw : Word;
        tt : Time;
        var1 : Variant;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_4pD"
    }
    NETWORK
        RUNG wire#powerrail
            Join(
                mode := #s_mode,
                recSeparator := #s_recseparator,
                endSeparator := #s_endseparator,
                srcStruct := #s_srcstruct,
                count := #s_count,
                ret_val => #s_ret_val,
                dstArray := #s_dstarray,
                position := #s_position
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
