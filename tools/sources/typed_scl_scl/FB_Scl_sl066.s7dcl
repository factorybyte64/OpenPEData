{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl066"
    VAR_INPUT
        v_in : Variant;
    END_VAR
    VAR_OUTPUT
        v_ret : Variant;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #v_ret := CountOfElements(IN := #v_in);
    END_NETWORK
END_FUNCTION_BLOCK
