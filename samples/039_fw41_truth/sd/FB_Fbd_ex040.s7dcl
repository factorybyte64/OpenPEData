{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ex040"
    VAR_INPUT
        v_size : DInt;
    END_VAR
    VAR_OUTPUT
        v_ret_val : WString;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            GetBlockName(
                size := #v_size,
                ret_val => #v_ret_val
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
