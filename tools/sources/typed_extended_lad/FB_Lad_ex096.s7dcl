{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex096"
    VAR_INPUT
        v_req : Bool;
        v_laddr : HW_IO;
        v_index : Int;
    END_VAR
    VAR_OUTPUT
        v_valid : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : DWord;
        v_len : Int;
    END_VAR
    VAR_IN_OUT
        v_record : Array[0..99] of Byte;
    END_VAR
    VAR
        inst : Rd_Dpar;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.Rd_Dpar( REQ := #v_req, LADDR := #v_laddr, INDEX := #v_index, RECORD := #v_record, VALID => #v_valid, BUSY => #v_busy, ERROR => #v_error, STATUS => #v_status, LEN => #v_len )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
