{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ex042"
    VAR_INPUT
        v_part : PIP;
        v_ret_val : Int;
    END_VAR
    VAR_OUTPUT
        v_fladdr : Word;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            UPDAT_PO(
                PART := #v_part,
                RET_VAL => #v_ret_val,
                FLADDR => #v_fladdr
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
