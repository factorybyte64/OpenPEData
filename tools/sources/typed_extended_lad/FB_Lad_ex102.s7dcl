{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex102"
    VAR_INPUT
        v_ob_nr : OB_CYCLIC;
        v_cycle : UDInt;
        v_phase : UDInt;
        v_ret_val : Int;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            Set_Cint( OB_NR := #v_ob_nr, CYCLE := #v_cycle, PHASE := #v_phase, RET_VAL := #v_ret_val )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
