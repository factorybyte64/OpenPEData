{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl047"
    VAR_INPUT
        v_in : Array[0..9] of Byte;
        v_count_in : USInt;
    END_VAR
    VAR_OUTPUT
        v_out : Array[0..9] of Bool;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        SCATTER_BLK(IN := #v_in[0], COUNT_IN := #v_count_in, OUT => #v_out[0]);
    END_NETWORK
END_FUNCTION_BLOCK
