{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ex159"
    VAR_INPUT
        v_ioid : Byte;
        v_laddr : HW_ANY;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_pecount : Int;
        v_pacount : Int;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            RD_LGADR(
                IOID := #v_ioid,
                LADDR := #v_laddr,
                RET_VAL => #v_ret_val,
                PEADDR => "DB_Arr".a[0],
                PECOUNT => #v_pecount,
                PAADDR => "DB_Arr".a[0],
                PACOUNT => #v_pacount
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
