{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FX_Lad_ex070"
    VAR_INPUT
        "a" : Bool;
        "b" : Bool;
        "c" : Bool;
        ia : Int;
        "ib" : Int;
        ic : Int;
        da : DInt;
        "db" : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
    END_VAR
    VAR_IN_OUT
        p_enable : Bool;
        p_id : HW_SUBMODULE;
        p_slot_no_x : Int;
        p_func_x : Int;
        p_busy : Bool;
        p_done : Bool;
        p_error : Bool;
        p_status : DWord;
        x_int : Int;
        arr : Array[0..9] of Int;
        barr : Array[0..7] of Bool;
        iinout : Int;
    END_VAR
    VAR
        { S7_Setpoint := "False" }
        inst : PE_DS3_Write_ET200S;
        ton1 : TON_TIME;
        tof1 : TOF_TIME;
        tp1 : TP_TIME;
        tonr1 : TONR_TIME;
        ctu1 : CTU_INT;
        ctd1 : CTD_INT;
        ctud1 : CTUD_INT;
        rtrig1 : R_TRIG;
        ftrig1 : F_TRIG;
        edge1 : Bool;
        edge2 : Bool;
        stat1 : Bool;
        stat2 : Bool;
        stati : Int;
    END_VAR
    VAR_TEMP
        t1 : Bool;
        t2 : Bool;
        ti : Int;
        td : DInt;
        tr : Real;
        tw : Word;
        tt : Time;
        var1 : Variant;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_4dC"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.PE_DS3_Write_ET200S(
                enable := #p_enable,
                ID := #p_id,
                Slot_No_1 := #x_int,
                Func_1 := #x_int,
                Slot_No_2 := #x_int,
                Func_2 := #x_int,
                Slot_No_3 := #x_int,
                Func_3 := #x_int,
                Slot_No_4 := #x_int,
                Func_4 := #x_int,
                Slot_No_5 := #x_int,
                Func_5 := #x_int,
                Slot_No_6 := #x_int,
                Func_6 := #x_int,
                Slot_No_7 := #x_int,
                Func_7 := #x_int,
                Slot_No_8 := #x_int,
                Func_8 := #x_int,
                busy => #p_busy,
                done => #p_done,
                error => #p_error,
                status => #p_status
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
