{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl014"
    VAR_INPUT
        v_cu : Bool;
        v_r : Bool;
        v_pv : Int;
    END_VAR
    VAR_OUTPUT
        v_q : Bool;
        v_cv : Char;
    END_VAR
    VAR
        inst : CTU_INT;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        #inst(CU := #v_cu, R := #v_r, PV := #v_pv, Q => #v_q, CV => #v_cv);
    END_NETWORK
END_FUNCTION_BLOCK
