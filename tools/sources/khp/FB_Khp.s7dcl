{
    S7_Optimized := "TRUE";
    S7_EditorMode := "SCL";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Khp"
    VAR_INPUT
        inp : Int;
    END_VAR
    VAR_OUTPUT
        outp : Bool;
    END_VAR
    VAR
        st : Real := 2.5;
        tmr : TON_TIME;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #outp := #inp > 0;
    END_NETWORK
END_FUNCTION_BLOCK
