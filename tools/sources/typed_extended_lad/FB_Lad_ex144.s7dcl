{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ex144"
    VAR_INPUT
        v_req : Bool;
        v_name : Array[0..99] of Byte;
        v_delfile : Bool;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_id : DWord;
    END_VAR
    VAR
        inst : DataLogDelete;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.DataLogDelete( REQ := #v_req, NAME := #v_name, DELFILE := #v_delfile, ID := #v_id, DONE => #v_done, BUSY => #v_busy, ERROR => #v_error, STATUS => #v_status )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
