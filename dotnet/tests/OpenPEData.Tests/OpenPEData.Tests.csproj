<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test runner without test framework packages (no installation needed): dotnet run, arguments see Program.Main -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenPEData.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenPEData\OpenPEData.csproj" />
  </ItemGroup>

</Project>
