{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ex158"
    VAR_INPUT
        v_laddr : HW_IO;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_area : Int;
        v_master : Int;
        v_station : Int;
        v_slot : Int;
        v_subslot : Int;
        v_offset : Int;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            LOG_GEO(
                LADDR := #v_laddr,
                RET_VAL => #v_ret_val,
                AREA => #v_area,
                MASTER => #v_master,
                STATION => #v_station,
                SLOT => #v_slot,
                SUBSLOT => #v_subslot,
                OFFSET => #v_offset
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
