{
    S7_Optimized := "TRUE"
}
DATA_BLOCK "DB_AllTypes"
    VAR
        { S7_MLC := "MLC_vBool" }
        vBool : Bool;
        vByte : Byte;
        vWord : Word;
        vDWord : DWord;
        vLWord : LWord;
        vSInt : SInt;
        vUSInt : USInt;
        vInt : Int;
        vUInt : UInt;
        vDInt : DInt;
        vUDInt : UDInt;
        vLInt : LInt;
        vULInt : ULInt;
        vReal : Real;
        vLReal : LReal;
        vS5Time : S5Time;
        vTime : Time;
        vLTime : LTime;
        vDate : Date;
        vTod : Time_Of_Day;
        vLTod : LTime_Of_Day;
        vDt : Date_And_Time;
        vLdt : LDT;
        vDtl : DTL;
        vChar : Char;
        vWChar : WChar;
        vString : String;
        vString10 : String[10];
        vWString : WString;
        vWString5 : WString[5];
        { S7_SetPoint := "True" }
        vSetpoint : Int;
        aNeg : Array[-2..2] of Int;
        a2d : Array[0..2, 1..3] of Real;
        a3d : Array[0..1, 0..1, 0..1] of Bool;
        aStr : Array[0..1] of String[8];
        aStruct : Array[0..1] of Struct
            x : Int;
            y : Bool;
        END_STRUCT;
        aUdt : Array[0..2] of "UDT_Inner";
        a2dUdt : Array[0..1, 0..1] of "UDT_Outer";
        outer : "UDT_Outer";
        deep : Struct
            l1 : Struct
                l2 : Struct
                    v : LReal;
                    arr : Array[0..1] of Struct
                        z : Word;
                    END_STRUCT;
                END_STRUCT;
            END_STRUCT;
        END_STRUCT;
        vTimer : IEC_TIMER;
        vCounter : IEC_COUNTER;
    END_VAR
    VAR RETAIN
        { S7_MLC := "MLC_rCount" }
        rCount : UDInt;
        rArr : Array[0..3] of Real;
    END_VAR
    vBool := TRUE;
    vByte := 16#12;
    vWord := 16#1234;
    vDWord := 16#12345678;
    vLWord := 16#123456789ABCDEF0;
    vSInt := -12;
    vUSInt := 200;
    vInt := -1234;
    vUInt := 60000;
    vDInt := -123456;
    vUDInt := 4000000000;
    vLInt := -9000000000;
    vULInt := 18000000000;
    vReal := 1.5;
    vLReal := -2.25;
    vS5Time := S5T#2S;
    vTime := T#1H2M3S;
    vLTime := LT#5MS;
    vDate := D#2026-11-05;
    vTod := TOD#12:34:56;
    vLTod := LTOD#01:02:03.5;
    vDt := DT#2026-11-05-12:00:00;
    vLdt := LDT#2026-11-05-12:00:00;
    vDtl.YEAR := 2026;
    vChar := 'A';
    vWChar := WCHAR#'Z';
    vString := 'hello';
    vString10 := 'ten';
    vWString := WSTRING#'wide';
    aNeg[-2] := -20;
    aNeg[2] := 20;
    a2d[1, 2] := 1.25;
    a3d[1, 1, 1] := TRUE;
    aStr[1] := 'abc';
    aStruct[1].x := 7;
    aUdt[2].Temp := 99.5;
    a2dUdt[1, 0].inner.Static := 5;
    outer.txt := 'changed';
    deep.l1.l2.v := 3.14;
    deep.l1.l2.arr[1].z := 16#BEEF;
    rArr[3] := 0.5;
END_DATA_BLOCK
