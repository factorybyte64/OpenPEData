{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ex134"
    VAR_INPUT
        v_pwm : HW_PWM;
        v_enable : Bool;
    END_VAR
    VAR_OUTPUT
        v_busy : Bool;
        v_status : Word;
    END_VAR
    VAR
        inst : CTRL_PWM;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.CTRL_PWM(
                PWM := #v_pwm,
                ENABLE := #v_enable,
                BUSY => #v_busy,
                STATUS => #v_status
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
