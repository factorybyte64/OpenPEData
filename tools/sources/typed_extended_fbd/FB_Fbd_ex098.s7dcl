{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex098"
    VAR_INPUT
        v_ioid : Byte;
        v_laddr : HW_IO;
        v_recnum : Byte;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    VAR_IN_OUT
        v_record : Variant;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Rd_Dparm( IOID := #v_ioid, LADDR := #v_laddr, RECNUM := #v_recnum, RET_VAL => #v_ret_val, RECORD := #v_record )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
