{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_ou021"
    VAR_INPUT
        v_req : Bool;
        v_interface : HW_INTERFACE;
        v_conf_data : Array[0..99] of Byte;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : DWord;
        v_err_loc : DWord;
    END_VAR
    VAR
        inst : T_CONFIG;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.T_CONFIG( REQ := #v_req, INTERFACE := #v_interface, CONF_DATA := #v_conf_data, DONE => #v_done, BUSY => #v_busy, ERROR => #v_error, STATUS => #v_status, ERR_LOC => #v_err_loc )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
