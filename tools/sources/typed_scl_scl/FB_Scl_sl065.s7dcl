{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl065"
    VAR_INPUT
        v_src : Date;
        v_dst : Variant;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        VariantPut(SRC := #v_src, DST := #v_dst);
    END_NETWORK
END_FUNCTION_BLOCK
