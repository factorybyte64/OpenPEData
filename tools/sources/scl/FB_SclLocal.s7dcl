{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_SclLocal"
    VAR_INPUT
        start : Bool;
    END_VAR
    VAR_IN_OUT
        io : Int;
    END_VAR
    VAR
        counter : Int;
        arr : Array[0..9] of Int;
        arr2 : Array[1..3, 1..4] of Real;
        mot : "UDT_Motor";
        st : Struct
            a : Int;
            b : Real;
            c : Array[0..2] of Bool;
        END_STRUCT;
    END_VAR
    VAR_TEMP
        i : Int;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        #arr[0] := 1;
        #arr[#i] := #arr[#i + 1] + #io;
        #arr2[2, 3] := 1.5;
        #st.a := 10;
        #st.b := #st.a;
        #st.c[1] := TRUE;
        #mot.Speed := 100.0;
        #mot.Running := #st.c[0];
        #counter += 1;
        #io := #counter;
    END_NETWORK
END_FUNCTION_BLOCK
