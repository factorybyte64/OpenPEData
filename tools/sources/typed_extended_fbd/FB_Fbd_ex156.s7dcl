{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex156"
    VAR_INPUT
        v_laddr : HW_IO;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_piaddr : UDInt;
        v_picount : UInt;
        v_pqaddr : UDInt;
        v_pqcount : UInt;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Rd_Addr( LADDR := #v_laddr, RET_VAL => #v_ret_val, PIADDR => #v_piaddr, PICOUNT => #v_picount, PQADDR => #v_pqaddr, PQCOUNT => #v_pqcount )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
