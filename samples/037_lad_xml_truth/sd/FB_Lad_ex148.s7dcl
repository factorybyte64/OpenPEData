{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ex148"
    VAR_INPUT
        v_req : Bool;
        v_ret_val : Int;
    END_VAR
    VAR_OUTPUT
        v_busy : Bool;
    END_VAR
    VAR_IN_OUT
        v_srcblk : Variant;
        v_dstblk : Variant;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            READ_DBL(
                REQ := #v_req,
                SRCBLK := #v_srcblk,
                RET_VAL => #v_ret_val,
                BUSY => #v_busy,
                DSTBLK => #v_dstblk
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
