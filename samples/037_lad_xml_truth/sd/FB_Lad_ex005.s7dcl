{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Lad_ex005"
    VAR_INPUT
        v_in1 : DTL;
        v_in2 : DTL;
        v_out : Time;
    END_VAR

    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            { S7_Templates := "[date_type := DTL, time_type := Time]" }
            T_DIFF(
                in1 := #v_in1,
                in2 := #v_in2,
                out => #v_out
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
