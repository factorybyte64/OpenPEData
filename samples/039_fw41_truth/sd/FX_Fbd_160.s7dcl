{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FX_Fbd_160"
    VAR_INPUT
        "a" : Bool;
        "b" : Bool;
        "c" : Bool;
        ia : Int;
        "ib" : Int;
        ic : Int;
        da : DInt;
        "db" : DInt;
        ra : Real;
        rb : Real;
        wa : Word;
        wb : Word;
        dwa : DWord;
        ba : Byte;
        ta : Time;
        tb : Time;
        s1 : String;
        s2 : String;
    END_VAR
    VAR_OUTPUT
        q : Bool;
        q2 : Bool;
        io : Int;
        io2 : Int;
        dout : DInt;
        rout : Real;
        wout : Word;
        dwout : DWord;
        bout : Byte;
        tout : Time;
        sout : String;
    END_VAR
    VAR_IN_OUT
        arr : Array[0..9] of Int;
        barr : Array[0..7] of Bool;
        iinout : Int;
    END_VAR
    VAR
        { S7_Setpoint := "False" }
        inst : DRUM;
        ton1 : TON_TIME;
        tof1 : TOF_TIME;
        tp1 : TP_TIME;
        tonr1 : TONR_TIME;
        ctu1 : CTU_INT;
        ctd1 : CTD_INT;
        ctud1 : CTUD_INT;
        rtrig1 : R_TRIG;
        ftrig1 : F_TRIG;
        edge1 : Bool;
        edge2 : Bool;
        stat1 : Bool;
        stat2 : Bool;
        stati : Int;
    END_VAR
    VAR_TEMP
        t1 : Bool;
        t2 : Bool;
        ti : Int;
        td : DInt;
        tr : Real;
        tw : Word;
        tt : Time;
        var1 : Variant;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_4ua"
    }
    NETWORK
        RUNG
            #inst.DRUM(
                RESET := #"a",
                JOG := #"a",
                DRUM_EN := #"a",
                LST_STEP := #wa,
                EVENT1 := #"a",
                EVENT2 := #"a",
                EVENT3 := #"a",
                EVENT4 := #"a",
                EVENT5 := #"a",
                EVENT6 := #"a",
                EVENT7 := #"a",
                EVENT8 := #"a",
                EVENT9 := #"a",
                EVENT10 := #"a",
                EVENT11 := #"a",
                EVENT12 := #"a",
                EVENT13 := #"a",
                EVENT14 := #"a",
                EVENT15 := #"a",
                EVENT16 := #"a",
                OUT1 => #q,
                OUT2 => #q,
                OUT3 => #q,
                OUT4 => #q,
                OUT5 => #q,
                OUT6 => #q,
                OUT7 => #q,
                OUT8 => #q,
                OUT9 => #q,
                OUT10 => #q,
                OUT11 => #q,
                OUT12 => #q,
                OUT13 => #q,
                OUT14 => #q,
                OUT15 => #q,
                OUT16 => #q,
                Q => #q,
                OUT_WORD => #wout,
                ERR_CODE => #wout
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
