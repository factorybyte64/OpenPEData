FUNCTION_BLOCK "FB_Fbd_ex061"
    VAR_INPUT
        v_laddr : HW_IO;
        v_record : Variant;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Dpwr_Dat( LADDR := #v_laddr, RECORD := #v_record, RET_VAL => #v_ret_val )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
