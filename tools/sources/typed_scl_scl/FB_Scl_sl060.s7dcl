{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl060"
    VAR_INPUT
        v_src_array : Byte;
    END_VAR
    VAR_OUTPUT
        v_dest_variable : Time_Of_Day;
    END_VAR
    VAR_IN_OUT
        v_pos : Array[0..9] of Byte;
    END_VAR
    { S7_Language := "SCL" }
    NETWORK
        READ_LITTLE(SRC_ARRAY := #v_src_array, DEST_VARIABLE => #v_dest_variable, POS := #v_pos[0]);
    END_NETWORK
END_FUNCTION_BLOCK
