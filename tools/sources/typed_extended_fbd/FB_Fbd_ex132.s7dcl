{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex132"
    VAR_INPUT
        v_laddr : HW_ANY;
        v_mode : UInt;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
    END_VAR
    VAR_IN_OUT
        v_diagevent : DiagnosticDetail;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Gen_Diag( LADDR := #v_laddr, MODE := #v_mode, DiagEvent := #v_diagevent, RET_VAL => #v_ret_val )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
