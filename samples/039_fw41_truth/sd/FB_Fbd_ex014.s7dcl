{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ex014"
    VAR_INPUT
        v_nr : RTM;
        v_mode : Byte;
        v_pv : DInt;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_cq : Bool;
        v_cv : DInt;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            RTM(
                NR := #v_nr,
                MODE := #v_mode,
                PV := #v_pv,
                RET_VAL => #v_ret_val,
                CQ => #v_cq,
                CV => #v_cv
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
