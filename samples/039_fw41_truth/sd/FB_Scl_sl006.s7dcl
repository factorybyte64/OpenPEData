{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Scl_sl006"
    VAR_INPUT
        v_in : Bool;
        v_r : Bool;
        v_pt : Time;
    END_VAR
    VAR_OUTPUT
        v_q : Bool;
        v_et : Time;
    END_VAR
    VAR
        inst : TONR_TIME;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        #inst(IN := #v_in, R := #v_r, PT := #v_pt, Q => #v_q, ET => #v_et);
    END_NETWORK
END_FUNCTION_BLOCK
