FUNCTION_BLOCK "FB_Fbd_ex111"
    VAR_INPUT
        v_ob_nr : Int;
    END_VAR
    VAR_OUTPUT
        v_ret_val : Int;
        v_status : Word;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            QRY_DINT(
                OB_NR := #v_ob_nr,
                RET_VAL => #v_ret_val,
                STATUS => #v_status
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
