{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "LAD"
}
FUNCTION_BLOCK "FB_Lad_pt007"
    VAR_INPUT
        v_req : Bool;
        v_port : PORT;
    END_VAR
    VAR_OUTPUT
        v_ndr : Bool;
        v_dtr : Bool;
        v_dsr : Bool;
        v_rts : Bool;
        v_cts : Bool;
        v_dcd : Bool;
        v_ring : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR
        inst : Signal_Get;
    END_VAR
    {
        S7_Language := "LAD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG wire#powerrail
            #inst.Signal_Get( REQ := #v_req, PORT := #v_port, NDR => #v_ndr, DTR => #v_dtr, DSR => #v_dsr, RTS => #v_rts, CTS => #v_cts, DCD => #v_dcd, RING => #v_ring, ERROR => #v_error, STATUS => #v_status )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
