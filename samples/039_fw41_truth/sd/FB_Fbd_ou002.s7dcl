{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "FB_Fbd_ou002"
    VAR_INPUT
        v_req : Bool;
        v_cont : Bool;
        v_len : UDInt;
    END_VAR
    VAR_OUTPUT
        v_done : Bool;
        v_busy : Bool;
        v_error : Bool;
        v_status : Word;
    END_VAR
    VAR_IN_OUT
        v_connect : Array[0..99] of Byte;
        v_data : Array[0..99] of Byte;
        v_addr : Array[0..99] of Byte;
        v_com_rst : Bool;
    END_VAR
    VAR
        inst : TSEND_C;
    END_VAR

    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            #inst.TSEND_C(
                REQ := #v_req,
                CONT := #v_cont,
                LEN := #v_len,
                DONE => #v_done,
                BUSY => #v_busy,
                ERROR => #v_error,
                STATUS => #v_status,
                CONNECT := #v_connect,
                DATA := #v_data,
                ADDR := #v_addr,
                COM_RST := #v_com_rst
            )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
