<Application x:Class="OpenPEData.Viewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PaneBg" Color="#F3F5F8"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#EEF1F5"/>
        <SolidColorBrush x:Key="Line" Color="#D5DAE1"/>
        <SolidColorBrush x:Key="Muted" Color="#5F6B7A"/>
        <SolidColorBrush x:Key="Accent" Color="#00808B"/>
    </Application.Resources>
</Application>
