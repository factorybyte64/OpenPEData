        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            Join( Mode := #v_mode, RecSeparator := #v_recseparator, EndSeparator := #v_endseparator, SrcStruct := #v_srcstruct, Count := #v_count, DestArray := 0, Position := #v_position, Ret_Val => #v_ret_val, DstArray := #v_dstarray )
