{
    S7_Optimized := "TRUE";
    S7_PreferredLanguage := "FBD"
}
FUNCTION_BLOCK "FB_Fbd_ex020"
    VAR_INPUT
        v_strg : Int;
        v_pchars : DInt;
    END_VAR
    VAR_OUTPUT
        v_cnt : UInt;
    END_VAR
    VAR_IN_OUT
        v_chars : Int;
    END_VAR
    {
        S7_Language := "FBD";
        S7_NetworkTitle := "MLC_N1"
    }
    NETWORK
        RUNG
            { S7_Templates := "[ptr_type := Int, strg_type := Int]" }
            Strg_To_Chars( STRG := #v_strg, PCHARS := #v_pchars, CHARS := #v_chars, CNT => #v_cnt )
        END_RUNG
    END_NETWORK
END_FUNCTION_BLOCK
